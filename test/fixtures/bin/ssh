#!/usr/bin/env bash
# Stand-in for ssh: drops options and the host, runs the command locally.
while [ $# -gt 0 ]; do
	case $1 in
	-O) exit 0 ;;
	-o|-l|-p) shift 2 ;;
	-*) shift ;;
	*) break ;;
	esac
done
shift
# Origins under $FAKE_DENY can't be read from the "server".
if [ -n "$FAKE_DENY" ]; then export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0="url./nonexistent$FAKE_DENY.insteadOf" GIT_CONFIG_VALUE_0="$FAKE_DENY"; fi
exec sh -c "$*"
