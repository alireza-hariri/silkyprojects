PROJECTS_DIR=/home/you/projects
TELEGRAM_BOT_TOKEN=123456:ABC...
# Only this Telegram user ID can bind the bot with /start (recommended).
SILKY_OWNER_ID=
# Optional: a local Bot API server (telegram-bot-api --local) to receive files over 20 MB.
TELEGRAM_API_ROOT=
# Optional: file holding the fallback proxy URL when Telegram is unreachable (default ~/.proxyaddr).
SILKY_PROXY_FILE=
# Optional: name of silky's own tmux server socket, for `tmux -L <name>` (default silky).
SILKY_TMUX_SOCKET=
# systemd doesn't load your shell profile: put node's bin dir on PATH (pi is found next to node).
# Set SILKY_PI only if pi lives somewhere else.
PATH=/home/you/.nvm/versions/node/v24.18.0/bin:/usr/local/bin:/usr/bin:/bin
