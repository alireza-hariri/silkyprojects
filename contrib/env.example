PROJECTS_DIR=/home/you/projects
TELEGRAM_BOT_TOKEN=123456:ABC...
# Only this Telegram user ID can bind the bot with /start (recommended).
SILKY_OWNER_ID=
# Optional: a local Bot API server (telegram-bot-api --local) to receive files over 20 MB.
TELEGRAM_API_ROOT=
# systemd doesn't load your shell profile: give the absolute paths of pi and node's bin dir.
SILKY_PI=/home/you/.nvm/versions/node/v24.18.0/bin/pi
PATH=/home/you/.nvm/versions/node/v24.18.0/bin:/usr/local/bin:/usr/bin:/bin
